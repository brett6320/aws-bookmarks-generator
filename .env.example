# One org per file. Pass several with --env-file for a combined multi-org page.
# Organizations (management or delegated-admin account)
AWS_PROFILE=
AWS_REGION=us-east-1

# Metadata table (name, account and region come from the ARN).
BG_DDB_TABLE_ARN=arn:aws:dynamodb:<region>:<account-id>:table/<table-name>
# Read with this profile if set; otherwise AWS_PROFILE if it's in the table's account,
# else BG_DDB_ROLE_NAME is assumed from AWS_PROFILE.
BG_DDB_PROFILE=
BG_DDB_ROLE_NAME=OrganizationAccountAccessRole

# Table attribute names (matched on account number)
BG_ATTR_ACCOUNT_ID=accountNumber
BG_ATTR_SHORT_NAME=accountShortCode
BG_ATTR_OU=ou
BG_ATTR_ENVIRONMENT=environment

# Per-account overrides (win over the table): account ID=value, comma-separated
# BG_ACCOUNT_ENVIRONMENTS=111122223333=Prd,444455556666=Sbx
BG_ACCOUNT_ENVIRONMENTS=
# BG_ACCOUNT_DOMAINS=111122223333=Payments
BG_ACCOUNT_DOMAINS=

# Page
# Default roles (comma-separated IAM role names, in display order). They seed each browser's
# role list; roles added here later are appended in browsers that already have a list, and
# roles a user removed in the page stay removed. Users can add/remove/reorder in the page.
BG_DEFAULT_ROLES=ReadOnly,Administrator
# Display names for roles (Role=Name, comma-separated); shown on links instead of long role names.
# Example: AWSReservedSSO_AdministratorAccess_1a2b3c4d=Admin,ReadOnlyAccess=Read only
BG_ROLE_NAMES=
# Roles for this org's accounts only, added after the global roles above
BG_ORG_ROLES=
# true: this org shows only BG_ORG_ROLES, not the global roles
BG_ORG_OMIT_GLOBAL_ROLES=false
BG_TITLE=AWS Accounts
BG_OUTPUT_DIR=output
BG_INCLUDE_INACTIVE=false
# Org name on a multi-org page (default: the env file name, e.g. prod.env -> prod)
BG_ORG_LABEL=
